---
// Reusable newsletter subscribe block — links to the LinkedIn newsletter
// "Weekly AI news for business" (urn:li:newsletter:7377233384185442304).
// LinkedIn handles the actual subscribe mechanic, so no backend is required.
interface Props {
	variant?: 'wide' | 'compact';
}
const { variant = 'wide' } = Astro.props;
const NEWSLETTER_URL =
	'https://www.linkedin.com/newsletters/weekly-ai-news-for-business-7377233384185442304/';
---

<section class={variant === 'compact' ? 'newsletter compact' : 'newsletter wide'}>
	<div class="newsletter-inner">
		<div class="newsletter-text">
			<p class="kicker">Weekly Newsletter</p>
			<h2 class="newsletter-h">Get the AI signal — not the noise.</h2>
			<p class="lede">
				Every week I distill what actually matters in AI for business leaders.
				One short read, every Monday. No fluff, no breathless hype — just the
				moves that change how decisions get made.
			</p>
			<ul class="bullets">
				<li>5-minute read, every Monday</li>
				<li>Curated AI news + the operational implications</li>
				<li>Companion to the <em>Future Bytes</em> podcast</li>
			</ul>
		</div>
		<div class="newsletter-cta-block">
			<a href={NEWSLETTER_URL} target="_blank" rel="noopener noreferrer" class="primary-cta">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
				Subscribe on LinkedIn
			</a>
			<p class="micro">Free · One click · Unsubscribe anytime</p>
			<a href="/podcast" class="secondary-cta">Or listen on Future Bytes →</a>
		</div>
	</div>
</section>

<style>
	.newsletter {
		background: var(--cream-soft);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		padding: 4rem 1.5rem;
	}
	.newsletter.compact {
		background: var(--cream);
		border-radius: 8px;
		border: 1px solid var(--rule);
		padding: 2.5rem 2rem;
		margin: 3rem 0;
	}
	.newsletter-inner {
		max-width: 64rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.compact .newsletter-inner {
		grid-template-columns: 1fr;
		gap: 1.5rem;
		text-align: center;
		max-width: 36rem;
	}
	.kicker {
		font-family: 'Inter', sans-serif;
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 600;
		margin: 0 0 0.85rem;
	}
	.newsletter-h {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin: 0 0 1rem;
		color: var(--ink);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	.lede {
		color: var(--text);
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		line-height: 1.65;
	}
	.bullets {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.bullets li {
		color: var(--text-muted);
		font-size: 0.95rem;
		padding: 0.25rem 0 0.25rem 1.25rem;
		position: relative;
	}
	.bullets li::before {
		content: '✦';
		color: var(--accent);
		position: absolute;
		left: 0;
		font-size: 0.85rem;
		top: 0.4rem;
	}
	.newsletter-cta-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: stretch;
	}
	.compact .newsletter-cta-block { align-items: center; }
	.primary-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		background: var(--ink);
		color: var(--cream);
		padding: 1rem 1.5rem;
		border-radius: 6px;
		font-weight: 500;
		font-size: 1rem;
		text-decoration: none;
		transition: background 0.2s;
	}
	.primary-cta:hover { background: var(--accent); color: var(--cream); }
	.micro {
		color: var(--text-muted);
		font-size: 0.82rem;
		margin: 0;
		text-align: center;
	}
	.secondary-cta {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		text-align: center;
		margin-top: 0.5rem;
	}
	.secondary-cta:hover { color: var(--accent-dark); }
	@media (max-width: 720px) {
		.newsletter { padding: 2.5rem 1rem; }
		.newsletter-inner { grid-template-columns: 1fr; gap: 1.5rem; }
		.newsletter-h { font-size: 1.6rem; }
	}
</style>
