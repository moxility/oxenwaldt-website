		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--cream);
		border-bottom: 1px solid var(--rule);
	}
	h2 { margin: 0; font-size: 1em; }
	h2 a, h2 a.active { text-decoration: none; color: var(--ink); font-weight: 600; }
	.site-logo {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.9em 0;
	}
	.logo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: var(--ink);
		color: var(--cream);
		border-radius: 6px;
		font-family: 'Newsreader', Georgia, serif;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.02em;
	}
	.logo-text {
		font-family: 'Newsreader', Georgia, serif;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 64rem;
		margin: 0 auto;
	}
	nav a {
		padding: 1.25em 0.75em;
		color: var(--text-muted);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		transition: color 0.15s, border-color 0.15s;
	}
	nav a:hover { color: var(--ink); }
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--ink);
		font-weight: 600;
	}
	.social-links { display: flex; gap: 0.5rem; }
	.social-links a {
		display: flex;
		padding: 0.5em;
		color: var(--text-muted);
		border-bottom: none;
	}
	.social-links a:hover { color: var(--accent); }
	@media (max-width: 720px) {
		.social-links { display: none; }
		header { padding: 0 1em; }
		nav a { padding: 1em 0.5em; font-size: 0.9rem; }
	}
</style>
