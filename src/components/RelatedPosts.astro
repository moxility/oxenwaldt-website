---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	currentSlug: string;
	currentTitle: string;
	currentDesc: string;
	limit?: number;
}

const { currentSlug, currentTitle, currentDesc, limit = 3 } = Astro.props;

const all = await getCollection('blog');

// Token-overlap similarity over (title + description). Cheap, works at
// build time, no client JS required.
function tokens(text: string): Set<string> {
	return new Set(
		text
			.toLowerCase()
			.replace(/[^\w\s]/g, ' ')
			.split(/\s+/)
			.filter(t => t.length > 3),
	);
}

const STOP = new Set([
	'with', 'this', 'that', 'from', 'have', 'will', 'just', 'they', 'were',
	'been', 'when', 'what', 'your', 'their', 'about', 'into', 'more', 'than',
	'then', 'them', 'some', 'these', 'those', 'most', 'much', 'over', 'like',
	'only', 'also', 'where', 'which', 'still', 'every', 'each', 'must',
	'should', 'could', 'would', 'really', 'quite', 'very',
]);

const currentTokens = new Set(
	[...tokens(`${currentTitle} ${currentDesc}`)].filter(t => !STOP.has(t)),
);

const scored = all
	.filter(p => p.id !== currentSlug)
	.map(p => {
		const candidate = new Set(
			[...tokens(`${p.data.title} ${p.data.description}`)].filter(t => !STOP.has(t)),
		);
		let overlap = 0;
		for (const t of candidate) if (currentTokens.has(t)) overlap++;
		return { post: p, score: overlap };
	})
	.filter(s => s.score > 0)
	.sort((a, b) => b.score - a.score)
	.slice(0, limit)
	.map(s => s.post);

// If overlap was sparse, fall back to recency
const related = scored.length >= limit
	? scored
	: [
		...scored,
		...all
			.filter(p => p.id !== currentSlug && !scored.find(s => s.id === p.id))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
			.slice(0, limit - scored.length),
	];
---

{related.length > 0 && (
	<aside class="related">
		<h2>Continue reading</h2>
		<div class="related-grid">
			{related.map(p => (
				<a href={`/blog/${p.id}/`} class="related-card">
					<time><FormattedDate date={p.data.pubDate} /></time>
					<h3>{p.data.title}</h3>
					<p>{p.data.description}</p>
				</a>
			))}
		</div>
	</aside>
)}

<style>
	.related {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}
	.related h2 {
		font-size: 1.4rem;
		margin: 0 0 1.5rem;
		color: var(--ink);
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.related-card {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: 1.25rem;
		background: var(--cream-soft);
		border: 1px solid var(--rule);
		border-radius: 6px;
		transition: border-color 0.2s, transform 0.2s;
	}
	.related-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.related-card time {
		font-size: 0.78rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-weight: 500;
	}
	.related-card h3 {
		font-size: 1.05rem;
		color: var(--ink);
		margin: 0.4rem 0 0.5rem;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.related-card p {
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.5;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.related-grid { grid-template-columns: 1fr; }
	}
</style>
