---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const speakingEvents = (await getCollection('speaking')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Speaking | ${SITE_TITLE}`} description="Magnus Oxenwaldt's speaking engagements on AI strategy, digital transformation, and enterprise architecture." />
	</head>
	<body>
		<Header />

		<section class="speak-hero">
			<div class="speak-hero-inner">
				<p class="kicker">Speaking</p>
				<h1>Keynotes &amp; executive briefings</h1>
				<p class="lede">
					Talks on AI strategy, digital transformation, and the systems-thinking
					behind durable enterprise change. Available worldwide for keynotes,
					panels, and board off-sites.
				</p>
				<a href="mailto:magnus@oxenwaldt.com?subject=Speaking%20enquiry" class="btn-primary">Enquire about speaking</a>
			</div>
		</section>

		<main class="speak-main">
			<section class="topics">
				<h2>Topics</h2>
				<div class="topics-grid">
					<div class="topic">
						<h3>AI strategy &amp; implementation</h3>
						<p>From pilot to production. Practical frameworks for enterprise AI adoption that deliver measurable ROI — not pitches, but patterns drawn from real engagements.</p>
					</div>
					<div class="topic">
						<h3>Digital transformation</h3>
						<p>Leading change through technology adoption. Capability building, change management, and where the real friction lives.</p>
					</div>
					<div class="topic">
						<h3>Enterprise architecture</h3>
						<p>Building scalable systems with ERP, CRM, and AI integration in complex organizations. Where AI lives and gets governed.</p>
					</div>
					<div class="topic">
						<h3>AI in retail &amp; e-commerce</h3>
						<p>Industry-specific perspective on customer experience, operations optimization, and what agentic commerce changes.</p>
					</div>
				</div>
			</section>

			{speakingEvents.length > 0 && (
				<section class="events">
					<h2>Selected events</h2>
					<div class="event-list">
						{speakingEvents.map((event) => (
							<article class="event">
								{event.data.heroImage && (
									<div class="event-image"><img src={event.data.heroImage} alt={event.data.title} /></div>
								)}
								<div class="event-body">
									<div class="event-meta">
										<span class="event-date">{event.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
										<span class="dot">·</span>
										<span>{event.data.event}</span>
										{event.data.featured && (<span class="pill">Featured</span>)}
									</div>
									<h3>{event.data.title}</h3>
									<p>{event.data.description}</p>
									<div class="event-foot">
										<span class="loc">📍 {event.data.location}</span>
										{event.data.tags && (
											<div class="tags">
												{event.data.tags.slice(0, 3).map((tag: string) => (<span class="tag">{tag}</span>))}
											</div>
										)}
									</div>
								</div>
							</article>
						))}
					</div>
				</section>
			)}

			{speakingEvents.length === 0 && (
				<section class="empty">
					<p>Upcoming events will be listed here.</p>
				</section>
			)}
		</main>

		<Footer />

		<style>
			.speak-hero {
				background: var(--cream);
				border-bottom: 1px solid var(--rule);
				padding: 4rem 1.5rem 3rem;
			}
			.speak-hero-inner { max-width: 56rem; margin: 0 auto; text-align: center; }
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.85rem;
				font-weight: 600;
			}
			.speak-hero h1 {
				font-size: clamp(2.4rem, 5vw, 3.4rem);
				margin: 0 0 1.25rem;
				color: var(--ink);
				line-height: 1.1;
			}
			.lede {
				color: var(--text);
				margin: 0 auto 2rem;
				font-size: 1.1rem;
				line-height: 1.65;
				max-width: 38rem;
			}
			.btn-primary {
				display: inline-flex;
				background: var(--ink);
				color: var(--cream);
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				font-weight: 500;
				text-decoration: none;
				transition: background 0.2s;
			}
			.btn-primary:hover { background: var(--accent); color: var(--cream); }

			.speak-main { max-width: 56rem; padding: 0 1.5rem; }
			.topics { padding: 3.5rem 0; border-bottom: 1px solid var(--rule); }
			.topics h2 { font-size: 1.6rem; margin: 0 0 2rem; color: var(--ink); }
			.topics-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
			}
			.topic h3 {
				font-size: 1.2rem;
				margin: 0 0 0.6rem;
				color: var(--ink);
			}
			.topic p {
				color: var(--text-muted);
				font-size: 0.98rem;
				line-height: 1.6;
				margin: 0;
			}

			.events { padding: 3.5rem 0 4rem; }
			.events h2 { font-size: 1.6rem; margin: 0 0 2rem; color: var(--ink); }
			.event-list { display: flex; flex-direction: column; gap: 2rem; }
			.event {
				display: grid;
				grid-template-columns: 12rem 1fr;
				gap: 2rem;
				align-items: flex-start;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--rule);
			}
			.event:last-child { border-bottom: none; padding-bottom: 0; }
			.event-image img {
				width: 100%;
				height: auto;
				aspect-ratio: 4/3;
				object-fit: cover;
				border-radius: 6px;
				border: 1px solid var(--rule);
			}
			.event-body { min-width: 0; }
			.event-meta {
				display: flex;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
				flex-wrap: wrap;
				align-items: center;
			}
			.event-date { font-weight: 500; }
			.dot { color: var(--rule); }
			.pill {
				background: var(--accent);
				color: var(--cream);
				font-size: 0.72rem;
				font-weight: 500;
				padding: 0.15rem 0.55rem;
				border-radius: 9999px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.event h3 {
				font-size: 1.4rem;
				margin: 0 0 0.6rem;
				color: var(--ink);
				line-height: 1.25;
			}
			.event p { color: var(--text-muted); margin: 0 0 0.75rem; line-height: 1.55; }
			.event-foot { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; font-size: 0.88rem; }
			.loc { color: var(--text-muted); }
			.tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
			.tag {
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				color: var(--text-muted);
				font-size: 0.75rem;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
			}

			.empty { padding: 4rem 0; text-align: center; color: var(--text-muted); }

			@media (max-width: 720px) {
				.topics-grid { grid-template-columns: 1fr; gap: 1.5rem; }
				.event { grid-template-columns: 1fr; gap: 1rem; }
				.event-image img { aspect-ratio: 16/9; }
				.speak-hero { padding: 3rem 1rem 2.5rem; }
				.topics, .events { padding: 2.5rem 0; }
			}
		</style>
	</body>
</html>
