---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const years = [...new Set(posts.map(post => post.data.pubDate.getFullYear()))].sort((a, b) => b - a);

const categorizePost = (title: string, description: string) => {
	const text = `${title} ${description}`.toLowerCase();
	if (text.includes('claude') || text.includes('anthropic')) return 'Claude & Anthropic';
	if (text.includes('gpt') || text.includes('openai') || text.includes('chatgpt')) return 'GPT & OpenAI';
	if (text.includes('ai') || text.includes('artificial intelligence') || text.includes('llm')) return 'AI & LLMs';
	if (text.includes('retail') || text.includes('ecommerce') || text.includes('shop')) return 'Retail & E-commerce';
	if (text.includes('digital transformation') || text.includes('enterprise')) return 'Digital Transformation';
	if (text.includes('podcast') || text.includes('future bytes')) return 'Podcast';
	return 'Technology';
};

// Hero images are matched to posts by slug rather than declared in frontmatter,
// so a post without a generated image used to emit a dead <img> that the browser
// silently hid via onerror. Eleven of the 2022-23 posts were in that state. Check
// the file at build time instead and fall back to a placeholder, so a missing
// image degrades to a real card rather than a hole in the grid.
const placeholderFor = (id: string) => {
	let hash = 0;
	for (const ch of id) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
	return `/blog-placeholder-${(hash % 5) + 1}.jpg`;
};

const postsWithCategories = await Promise.all(posts.map(async (post) => {
	const generated = `/blog-images/${post.id}.png`;
	// Resolve against the project root, NOT import.meta.url: Astro compiles this
	// frontmatter into a bundled chunk, so import.meta.url is not the source path
	// at build time and every lookup silently missed — which served a placeholder
	// for all 85 posts instead of the 11 that need one.
	const imagePath = existsSync(join(process.cwd(), 'public', generated))
		? generated
		: placeholderFor(post.id);
	const bodyText = post.body ? post.body
		.replace(/#+\s/g, '')
		.replace(/\*\*([^*]+)\*\*/g, '$1')
		.replace(/\*([^*]+)\*/g, '$1')
		.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
		.replace(/`[^`]+`/g, '')
		.replace(/```[\s\S]*?```/g, '')
		.replace(/[-*+]\s/g, '')
		.replace(/\n+/g, ' ')
		.toLowerCase()
		.slice(0, 1000) : '';
	return { ...post, category: categorizePost(post.data.title, post.data.description), generatedImage: imagePath, searchableContent: bodyText };
}));

const categories = [...new Set(postsWithCategories.map(p => p.category))];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="blog-hero">
			<div class="blog-hero-inner">
				<p class="kicker">Essays</p>
				<h1>Writing on AI, transformation &amp; enterprise reality</h1>
				<p class="lede">
					Long-form takes on AI strategy, the lessons from twenty years inside enterprise architecture, and what's actually working — versus what's just being pitched.
				</p>
			</div>
		</section>

		<main class="blog-main">
			<div class="filters">
				<input type="text" id="searchInput" placeholder="Search essays, topics, content…" />

				<div class="filter-group">
					<button class="filter-btn active" data-filter="all">All</button>
					{categories.map(category => (<button class="filter-btn" data-filter={category}>{category}</button>))}
				</div>

				<div class="year-group">
					<button class="year-btn active" data-year="all">All years</button>
					{years.map(year => (<button class="year-btn" data-year={year}>{year}</button>))}
				</div>
			</div>

			<div id="postsContainer" class="posts-grid">
				{postsWithCategories.map((post) => (
					<article class="post-card" data-category={post.category} data-year={post.data.pubDate.getFullYear()} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()} data-content={post.searchableContent}>
						<a href={`/blog/${post.id}/`}>
							<div class="post-image">
								<img src={post.generatedImage} alt={post.data.title} loading="lazy" onerror="this.style.display='none'" />
							</div>
							<div class="post-content">
								<div class="post-meta">
									<span class="cat">{post.category}</span>
									<span class="dot">·</span>
									<time><FormattedDate date={post.data.pubDate} /></time>
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					</article>
				))}
			</div>

			<div id="noResults" class="no-results hidden">
				<p>No essays match those filters. <button id="clearFilters" class="link-btn">Clear filters</button></p>
			</div>
		</main>

		<Footer />

		<script>
			const searchInput = document.getElementById('searchInput') as HTMLInputElement;
			const postsContainer = document.getElementById('postsContainer');
			const noResults = document.getElementById('noResults');
			const postCards = document.querySelectorAll('.post-card');
			const filterBtns = document.querySelectorAll('.filter-btn');
			const yearBtns = document.querySelectorAll('.year-btn');
			const clearBtn = document.getElementById('clearFilters');
			let activeCategory = 'all', activeYear = 'all', searchQuery = '';

			function filterPosts() {
				let visible = 0;
				postCards.forEach((card) => {
					const c = card.getAttribute('data-category');
					const y = card.getAttribute('data-year');
					const t = card.getAttribute('data-title') || '';
					const d = card.getAttribute('data-description') || '';
					const body = card.getAttribute('data-content') || '';
					const okC = activeCategory === 'all' || c === activeCategory;
					const okY = activeYear === 'all' || y === activeYear;
					const okS = searchQuery === '' || t.includes(searchQuery) || d.includes(searchQuery) || body.includes(searchQuery);
					if (okC && okY && okS) { (card as HTMLElement).style.display = ''; visible++; }
					else (card as HTMLElement).style.display = 'none';
				});
				if (visible === 0) { noResults?.classList.remove('hidden'); postsContainer?.classList.add('hidden'); }
				else { noResults?.classList.add('hidden'); postsContainer?.classList.remove('hidden'); }
			}
			searchInput?.addEventListener('input', (e) => { searchQuery = (e.target as HTMLInputElement).value.toLowerCase(); filterPosts(); });
			filterBtns.forEach(btn => btn.addEventListener('click', () => {
				filterBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				activeCategory = btn.getAttribute('data-filter') || 'all';
				filterPosts();
			}));
			yearBtns.forEach(btn => btn.addEventListener('click', () => {
				yearBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				activeYear = btn.getAttribute('data-year') || 'all';
				filterPosts();
			}));
			clearBtn?.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				searchQuery = '';
				activeCategory = 'all'; activeYear = 'all';
				filterBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-filter') === 'all'));
				yearBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-year') === 'all'));
				filterPosts();
			});
		</script>

		<style>
			.blog-hero {
				background: var(--cream);
				border-bottom: 1px solid var(--rule);
				padding: 4rem 1.5rem 3rem;
			}
			.blog-hero-inner { max-width: 56rem; margin: 0 auto; text-align: center; }
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.85rem;
				font-weight: 600;
			}
			.blog-hero h1 {
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				margin: 0 0 1rem;
				color: var(--ink);
				line-height: 1.1;
			}
			.lede {
				color: var(--text);
				margin: 0 auto;
				font-size: 1.1rem;
				line-height: 1.65;
				max-width: 38rem;
			}

			.blog-main { max-width: 72rem; margin: 0 auto; padding: 3rem 1.5rem 4rem; }

			.filters { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 3rem; }
			#searchInput {
				width: 100%;
				padding: 0.85rem 1.25rem;
				font-size: 1rem;
				background: var(--cream);
				border: 1px solid var(--rule);
				border-radius: 6px;
				color: var(--ink);
				transition: border-color 0.2s;
				font-family: inherit;
			}
			#searchInput:focus { outline: none; border-color: var(--accent); }
			.filter-group, .year-group { display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.filter-btn, .year-btn {
				background: var(--cream);
				border: 1px solid var(--rule);
				color: var(--text-muted);
				padding: 0.45rem 1rem;
				border-radius: 9999px;
				font-size: 0.88rem;
				font-weight: 500;
				cursor: pointer;
				font-family: inherit;
				transition: all 0.2s;
			}
			.year-btn { font-size: 0.82rem; padding: 0.35rem 0.85rem; }
			.filter-btn:hover, .year-btn:hover { border-color: var(--ink); color: var(--ink); }
			.filter-btn.active, .year-btn.active {
				background: var(--ink);
				border-color: var(--ink);
				color: var(--cream);
			}

			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem;
			}
			.post-card { background: transparent; }
			.post-card a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-image {
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				border-radius: 6px;
				overflow: hidden;
				aspect-ratio: 16/10;
				margin-bottom: 1rem;
			}
			.post-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.4s;
			}
			.post-card a:hover .post-image img { transform: scale(1.03); }
			.post-meta {
				display: flex;
				gap: 0.5rem;
				font-size: 0.78rem;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				font-weight: 500;
				align-items: center;
			}
			.cat { color: var(--accent); }
			.dot { color: var(--rule); }
			.post-card h3 {
				font-size: 1.3rem;
				margin: 0 0 0.55rem;
				color: var(--ink);
				line-height: 1.25;
				transition: color 0.2s;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card a:hover h3 { color: var(--accent); }
			.post-card p {
				color: var(--text-muted);
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.no-results { text-align: center; padding: 4rem 1rem; color: var(--text-muted); }
			.link-btn {
				background: none;
				border: none;
				color: var(--accent);
				cursor: pointer;
				text-decoration: underline;
				font-size: inherit;
				font-family: inherit;
				padding: 0;
			}
			.hidden { display: none; }

			@media (max-width: 960px) {
				.posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			}
			@media (max-width: 600px) {
				.posts-grid { grid-template-columns: 1fr; }
				.blog-hero { padding: 2.5rem 1rem 2rem; }
				.blog-main { padding: 2rem 1rem 3rem; }
			}
		</style>
	</body>
</html>
