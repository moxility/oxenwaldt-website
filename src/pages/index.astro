---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6);

// Helper function to get image path for a blog post
function getImagePath(slug: string) {
	return `/blog-images/${slug}.png`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero Section - Modern Monochrome with Background -->
		<section class="bg-slate-900 text-white relative overflow-hidden">
			<div class="absolute inset-0 opacity-30">
				<img src="/images/hero_banner_20251210_170506.png" alt="" class="w-full h-full object-cover" />
			</div>
			<div class="max-w-5xl mx-auto px-6 py-24 md:py-32 relative z-10">
				<div class="flex flex-col md:flex-row items-center gap-12">
					<!-- Portrait -->
					<div class="flex-shrink-0">
						<img
							src="/images/magnus_portrait_casual.png"
							alt="Magnus Oxenwaldt"
							class="w-40 h-40 md:w-52 md:h-52 rounded-2xl object-cover shadow-2xl border-2 border-slate-700"
						/>
					</div>
					<!-- Text Content -->
					<div class="text-center md:text-left">
						<h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
							Magnus Oxenwaldt
						</h1>
						<p class="text-2xl md:text-3xl text-slate-400 mb-6 font-light">
							AI & Digital Transformation Leader
						</p>
						<p class="text-lg text-slate-500 mb-12 max-w-2xl leading-relaxed">
							Principal Business Consultant pioneering AI-driven solutions that revolutionize enterprise processes. Host of Future Bytes podcast. Over 20 years bridging emerging technologies with practical business applications across ERP, Customer Engagement, and AI integration.
						</p>
						<div class="flex gap-4 flex-wrap justify-center md:justify-start">
							<a href="/blog" class="bg-teal-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-teal-700 transition-colors">
								Read Articles
							</a>
							<a href="/podcast" class="border-2 border-slate-600 text-slate-300 px-8 py-4 rounded-lg font-semibold hover:bg-slate-800 hover:border-slate-500 transition-colors">
								Listen to Podcast
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- What I Do - Icon Cards -->
		<section class="py-20 bg-slate-50">
			<div class="max-w-5xl mx-auto px-6">
				<h2 class="text-3xl md:text-4xl font-bold mb-12 text-slate-900">Areas of Expertise</h2>
				<div class="grid md:grid-cols-3 gap-8">
					<!-- Card 1 -->
					<div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow border border-slate-100">
						<div class="w-14 h-14 bg-slate-800 rounded-xl flex items-center justify-center mb-6">
							<svg class="w-7 h-7 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3 text-slate-900 whitespace-nowrap">AI Solutions</h3>
						<p class="text-slate-600 leading-relaxed">
							Pioneering AI-driven solutions using GPT-4, Azure OpenAI, and frontier models. Measurable business outcomes.
						</p>
					</div>

					<!-- Card 2 -->
					<div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow border border-slate-100">
						<div class="w-14 h-14 bg-slate-800 rounded-xl flex items-center justify-center mb-6">
							<svg class="w-7 h-7 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3 text-slate-900 whitespace-nowrap">Enterprise</h3>
						<p class="text-slate-600 leading-relaxed">
							Dynamics 365, Microsoft Azure, Power Platform. Complex digital transformation across diverse industries.
						</p>
					</div>

					<!-- Card 3 -->
					<div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow border border-slate-100">
						<div class="w-14 h-14 bg-slate-800 rounded-xl flex items-center justify-center mb-6">
							<svg class="w-7 h-7 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-3 text-slate-900 whitespace-nowrap">Podcast</h3>
						<p class="text-slate-600 leading-relaxed">
							Host of Future Bytes exploring AI's real impact on business—no fluff, just AI that works.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Latest Articles - Clean List Style -->
		<section class="py-20 bg-white">
			<div class="max-w-5xl mx-auto px-6">
				<div class="flex justify-between items-center mb-12">
					<h2 class="text-3xl md:text-4xl font-bold text-slate-900">Latest Posts</h2>
					<a href="/blog" class="text-teal-600 hover:text-teal-700 font-semibold flex items-center gap-2">
						View all
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>
				<div class="space-y-6">
					{posts.map((post) => (
						<article class="border-b border-gray-200 pb-6 last:border-0">
							<a href={`/blog/${post.id}/`} class="group block">
								<div class="flex items-start gap-6">
									<div class="flex-1">
										<time class="text-sm text-slate-500 mb-2 block">
											<FormattedDate date={post.data.pubDate} />
										</time>
										<h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-teal-600 transition-colors leading-tight">
											{post.data.title}
										</h3>
										<p class="text-slate-600 leading-relaxed">
											{post.data.description}
										</p>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-20 bg-slate-900 text-white">
			<div class="max-w-5xl mx-auto px-6 text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Connect</h2>
				<p class="text-xl text-slate-400 mb-8 max-w-2xl mx-auto">
					Available for consulting, speaking engagements, and strategic advisory worldwide.
				</p>
				<a
					href="https://www.linkedin.com/in/magnusoxenwaldt/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-3 bg-teal-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-teal-700 transition-colors">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
					Connect on LinkedIn
				</a>
			</div>
		</section>

		<Footer />
	</body>
</html>
