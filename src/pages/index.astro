---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white">
		<Header />
		<main class="p-0">
			<!-- Hero Section -->
			<section class="relative bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white overflow-hidden">
				<div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40"></div>
				<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
					<div class="max-w-4xl">
						<div class="inline-block mb-4 px-4 py-2 bg-blue-500/20 backdrop-blur-sm border border-blue-400/30 rounded-full text-sm font-medium text-blue-200">
							AI & Digital Transformation Leader
						</div>
						<h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight">
							Magnus Oxenwaldt
						</h1>
						<p class="text-xl md:text-2xl mb-8 text-slate-300 leading-relaxed max-w-3xl">
							Empowering organizations through artificial intelligence and digital innovation.
							Over 20 years of expertise in enterprise architecture, ERP systems, and business transformation.
						</p>
						<div class="flex flex-wrap gap-4">
							<a href="/blog" class="group inline-flex items-center gap-2 bg-white text-blue-900 px-8 py-4 rounded-lg font-semibold hover:bg-blue-50 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
								<span>Explore My Insights</span>
								<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
								</svg>
							</a>
							<a href="/about" class="inline-flex items-center gap-2 border-2 border-white/30 backdrop-blur-sm text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 hover:border-white/50 transition-all">
								Learn More
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Stats Bar -->
			<section class="bg-slate-50 border-y border-slate-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
					<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
						<div class="text-center">
							<div class="text-4xl font-bold text-blue-600 mb-2">20+</div>
							<div class="text-sm text-slate-600 font-medium">Years Experience</div>
						</div>
						<div class="text-center">
							<div class="text-4xl font-bold text-blue-600 mb-2">∞</div>
							<div class="text-sm text-slate-600 font-medium">Transformations Led</div>
						</div>
						<div class="text-center">
							<div class="text-4xl font-bold text-blue-600 mb-2">AI</div>
							<div class="text-sm text-slate-600 font-medium">Focused Solutions</div>
						</div>
						<div class="text-center">
							<div class="text-4xl font-bold text-blue-600 mb-2">🎙️</div>
							<div class="text-sm text-slate-600 font-medium">Podcast Host</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Areas -->
			<section class="py-20 px-4 bg-white">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-16">
						<h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">Areas of Expertise</h2>
						<p class="text-xl text-slate-600 max-w-2xl mx-auto">
							Bridging technology and business to drive meaningful transformation
						</p>
					</div>
					<div class="grid md:grid-cols-3 gap-8">
						<div class="group bg-white p-8 rounded-2xl border-2 border-slate-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
							<div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
								</svg>
							</div>
							<h3 class="text-2xl font-bold mb-4 text-slate-900">Artificial Intelligence</h3>
							<p class="text-slate-600 leading-relaxed">
								AI-driven solutions and integration strategies for enterprise applications,
								with focus on practical implementation and measurable business value.
							</p>
						</div>
						<div class="group bg-white p-8 rounded-2xl border-2 border-slate-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
							<div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
								</svg>
							</div>
							<h3 class="text-2xl font-bold mb-4 text-slate-900">Digital Transformation</h3>
							<p class="text-slate-600 leading-relaxed">
								Leading enterprise-wide transformation initiatives, change management,
								and helping organizations adapt to the digital age with confidence.
							</p>
						</div>
						<div class="group bg-white p-8 rounded-2xl border-2 border-slate-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
							<div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
								</svg>
							</div>
							<h3 class="text-2xl font-bold mb-4 text-slate-900">Enterprise Architecture</h3>
							<p class="text-slate-600 leading-relaxed">
								Designing scalable, sustainable solutions with ERP systems, customer
								engagement platforms, and integrated business applications.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Future Bytes Podcast -->
			<section class="bg-gradient-to-br from-slate-900 to-blue-900 py-20 px-4">
				<div class="max-w-6xl mx-auto">
					<div class="grid md:grid-cols-2 gap-12 items-center">
						<div>
							<div class="inline-block mb-4 px-4 py-2 bg-green-500/20 border border-green-400/30 rounded-full text-sm font-medium text-green-300">
								Podcast
							</div>
							<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Future Bytes</h2>
							<p class="text-xl text-slate-300 mb-8 leading-relaxed">
								Exploring AI's positive impact on business. Join me as we discuss practical
								implementation strategies and discover how organizations can harness artificial
								intelligence to enhance efficiency and foster innovation.
							</p>
							<a href="https://open.spotify.com/show/2dUyQaG5wFvCPBkB2ErHKe"
							   target="_blank"
							   rel="noopener noreferrer"
							   class="inline-flex items-center gap-3 bg-green-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-green-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
								</svg>
								<span>Listen on Spotify</span>
							</a>
						</div>
						<div class="relative">
							<div class="aspect-square bg-gradient-to-br from-green-500/20 to-blue-500/20 rounded-3xl border-2 border-white/10 backdrop-blur-sm flex items-center justify-center">
								<svg class="w-32 h-32 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Recent Blog Posts -->
			<section class="py-20 px-4 bg-slate-50">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-16">
						<h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">Latest Insights</h2>
						<p class="text-xl text-slate-600 max-w-2xl mx-auto">
							Thoughts on AI, digital transformation, and enterprise technology
						</p>
					</div>
					<div class="grid md:grid-cols-3 gap-8">
						{posts.map((post) => (
							<article class="group bg-white rounded-2xl overflow-hidden border-2 border-slate-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
								<div class="p-8">
									<div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
										</svg>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="text-2xl font-bold mb-4 text-slate-900 group-hover:text-blue-600 transition-colors">
										<a href={`/blog/${post.slug}/`} class="hover:underline">
											{post.data.title}
										</a>
									</h3>
									<p class="text-slate-600 leading-relaxed mb-4">
										{post.data.description}
									</p>
									<a href={`/blog/${post.slug}/`} class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all">
										<span>Read more</span>
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
										</svg>
									</a>
								</div>
							</article>
						))}
					</div>
					<div class="text-center mt-12">
						<a href="/blog" class="inline-flex items-center gap-2 bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
							<span>View All Posts</span>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="bg-gradient-to-r from-blue-600 to-indigo-600 py-20 px-4">
				<div class="max-w-4xl mx-auto text-center">
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Let's Connect</h2>
					<p class="text-xl text-blue-100 mb-10 leading-relaxed max-w-2xl mx-auto">
						Available for collaborations and talks worldwide. Interested in discussing
						AI, digital transformation, or enterprise architecture?
					</p>
					<div class="flex flex-wrap justify-center gap-4">
						<a href="https://www.linkedin.com/in/magnusoxenwaldt/"
						   target="_blank"
						   rel="noopener noreferrer"
						   class="inline-flex items-center gap-3 bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-blue-50 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
							<span>Connect on LinkedIn</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
