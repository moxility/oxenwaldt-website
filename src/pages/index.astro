---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

import { PUBLIC_APPS } from '../data/apps.mjs';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6);

// Front-page strip: the shipped ones first, so the row leads with what you can
// actually download rather than with what is still in review.
const stateRank = { live: 0, review: 1, prep: 2, building: 3, internal: 4 };
const featuredApps = [...PUBLIC_APPS]
	.sort((a, b) => stateRank[a.state] - stateRank[b.state])
	.slice(0, 6);

const appIcon = (app: { accent: string; glyph: string }) =>
	'data:image/svg+xml,' +
	encodeURIComponent(
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">` +
			`<rect width="100" height="100" rx="18" fill="#0D2454"/>` +
			`<path fill="none" stroke="${app.accent}" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" d="${app.glyph}"/>` +
			`</svg>`,
	);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} pageType="profile" />
	</head>
	<body>
		<Header />

		<!-- Hero — light editorial -->
		<section class="hero">
			<div class="hero-inner">
				<div class="hero-portrait">
					<img
						src="/images/magnus_portrait_casual.png"
						alt="Magnus Oxenwaldt"
						class="portrait"
					/>
				</div>
				<div class="hero-text">
					<p class="kicker">AI &amp; Digital Transformation</p>
					<h1>Magnus Oxenwaldt</h1>
					<p class="lede">
						I help enterprises turn AI from a slide into a system. VP Group AI at
						Columbus Global, host of the <em>Future Bytes</em> podcast, and a
						twenty-year veteran of bridging emerging technology and operating reality.
					</p>
					<div class="hero-cta">
						<a href="/blog" class="btn btn-primary">Read the essays</a>
						<a href="/podcast" class="btn btn-ghost">Listen to Future Bytes</a>
						<a href="https://www.linkedin.com/in/magnusoxenwaldt/" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Follow on LinkedIn</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Areas of focus — editorial cards -->
		<section class="band band-soft">
			<div class="band-inner">
				<h2 class="section-h">Areas of focus</h2>
				<div class="cards">
					<a href="/frontier" class="card card-link">
						<h3>The Frontier Approach</h3>
						<p>My methodology for moving enterprises from AI experimentation to durable agentic systems. Read the framework →</p>
					</a>
					<article class="card">
						<h3>Enterprise transformation</h3>
						<p>Two decades inside Dynamics 365, Microsoft Azure, and the Power Platform. Architecture decisions that hold up when the slides go away.</p>
					</article>
					<article class="card">
						<h3>Speaking &amp; advisory</h3>
						<p>Keynotes, executive briefings, and board advisory on how AI changes business models — not just workflows.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Latest essays -->
		<section class="band">
			<div class="band-inner">
				<div class="section-head">
					<h2 class="section-h">Latest essays</h2>
					<a href="/blog" class="link-arrow">Browse all →</a>
				</div>
				<div class="post-list">
					{posts.map((post) => (
						<article class="post-row">
							<a href={`/blog/${post.id}/`} class="post-link">
								<time class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</time>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-desc">{post.data.description}</p>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- Apps -->
		<section class="band band-soft">
			<div class="band-inner">
				<div class="section-head">
					<h2 class="section-h">Apps I build</h2>
					<a href="/apps" class="link-arrow">See all {PUBLIC_APPS.length} →</a>
				</div>
				<p class="band-lede apps-lede">
					Certification practice, executive writing tools, and the companions to the
					books — all with the AI running on the phone rather than on someone
					else&rsquo;s server.
				</p>
				<div class="app-strip">
					{featuredApps.map((app) => (
						<a href={`/${app.slug}/index.html`} class="app-chip">
							<img src={appIcon(app)} alt="" width="40" height="40" loading="lazy" />
							<span>
								<b>{app.name}</b>
								<span>{app.tagline}</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Newsletter -->
		<NewsletterSubscribe variant="wide" />

		<!-- Closing CTA -->
		<section class="band band-tight">
			<div class="band-inner band-center">
				<h2 class="section-h">Let's work together</h2>
				<p class="band-lede">
					Available for executive advisory, keynote speaking, and strategic consulting on AI and digital transformation.
				</p>
				<div class="hero-cta center">
					<a href="https://www.linkedin.com/in/magnusoxenwaldt/" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message on LinkedIn</a>
					<a href="mailto:magnus@oxenwaldt.com" class="btn btn-ghost">Email Magnus</a>
				</div>
			</div>
		</section>

		<Footer />

		<style>
			.hero {
				background: var(--cream);
				border-bottom: 1px solid var(--rule);
				padding: 4.5rem 1.5rem 5rem;
			}
			.hero-inner {
				max-width: 64rem;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				align-items: center;
			}
			.hero-portrait { flex-shrink: 0; }
			.portrait {
				width: 11rem;
				height: 11rem;
				border-radius: 9999px;
				object-fit: cover;
				border: 1px solid var(--rule);
				box-shadow: var(--box-shadow-lg);
			}
			.hero-text { flex: 1; }
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.85rem;
				font-weight: 600;
			}
			.hero h1 {
				font-size: clamp(2.6rem, 5vw, 3.8rem);
				margin: 0 0 1.25rem;
				color: var(--ink);
				line-height: 1.05;
			}
			.lede {
				font-size: 1.2rem;
				line-height: 1.65;
				color: var(--text);
				max-width: 38rem;
				margin: 0 0 2rem;
			}
			.hero-cta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.hero-cta.center { justify-content: center; }
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.7rem 1.4rem;
				border-radius: 6px;
				font-weight: 500;
				font-size: 0.95rem;
				text-decoration: none;
				transition: background 0.2s, color 0.2s, border-color 0.2s;
				border: 1px solid transparent;
			}
			.btn-primary {
				background: var(--ink);
				color: var(--cream);
			}
			.btn-primary:hover { background: var(--accent); color: var(--cream); }
			.btn-ghost {
				background: transparent;
				color: var(--ink);
				border-color: var(--rule);
			}
			.btn-ghost:hover { border-color: var(--ink); }

			.band { padding: 5rem 1.5rem; background: var(--cream); }
			.band-soft { background: var(--cream-soft); }
			.band-tight { padding: 4rem 1.5rem; }
			.band-inner { max-width: 64rem; margin: 0 auto; }
			.band-center { text-align: center; }
			.band-lede {
				font-size: 1.15rem;
				color: var(--text);
				max-width: 38rem;
				margin: 0 auto 2rem;
			}
			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2.5rem;
				border-bottom: 1px solid var(--rule);
				padding-bottom: 1rem;
			}
			.section-h {
				font-size: 1.6rem;
				margin: 0 0 2rem;
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.section-head .section-h { margin: 0; }
			.link-arrow {
				color: var(--accent);
				font-size: 0.95rem;
				font-weight: 500;
				text-decoration: none;
			}
			.link-arrow:hover { color: var(--accent-dark); }

			.apps-lede { margin: -0.25rem 0 1.75rem; max-width: 44rem; }
			.app-strip {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
				gap: 0.85rem;
			}
			.app-chip {
				display: flex;
				gap: 0.85rem;
				align-items: center;
				padding: 0.85rem 1rem;
				background: var(--cream);
				border: 1px solid var(--rule);
				border-radius: 10px;
				text-decoration: none;
				color: var(--text);
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.app-chip:hover { border-color: var(--accent); box-shadow: var(--box-shadow); color: var(--text); }
			.app-chip img { border-radius: 10px; flex: none; margin: 0; }
			.app-chip b {
				display: block;
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1rem;
				color: var(--ink);
				line-height: 1.3;
			}
			.app-chip span span {
				display: block;
				font-size: 0.85rem;
				color: var(--text-muted);
				line-height: 1.4;
			}

			.cards {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem;
			}
			.card {
				background: var(--cream);
				border: 1px solid var(--rule);
				border-radius: 8px;
				padding: 1.75rem;
				transition: border-color 0.2s, transform 0.2s;
			}
			.card:hover { border-color: var(--accent); transform: translateY(-2px); }
			.card-link { text-decoration: none; color: inherit; display: block; }
			.card-link:hover h3 { color: var(--accent); }
			.card h3 {
				font-size: 1.25rem;
				margin: 0 0 0.75rem;
				color: var(--ink);
			}
			.card p {
				font-size: 0.98rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}

			.post-list {
				display: flex;
				flex-direction: column;
			}
			.post-row {
				border-bottom: 1px solid var(--rule);
				padding: 1.5rem 0;
			}
			.post-row:last-child { border-bottom: none; }
			.post-link {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-date {
				font-size: 0.85rem;
				color: var(--text-muted);
				display: block;
				margin-bottom: 0.4rem;
				letter-spacing: 0.02em;
				text-transform: uppercase;
				font-weight: 500;
			}
			.post-title {
				font-size: 1.55rem;
				margin: 0 0 0.5rem;
				color: var(--ink);
				line-height: 1.25;
				transition: color 0.2s;
			}
			.post-link:hover .post-title { color: var(--accent); }
			.post-desc {
				color: var(--text-muted);
				margin: 0;
				font-size: 1rem;
				line-height: 1.55;
			}

			@media (max-width: 720px) {
				.hero { padding: 3rem 1rem 3.5rem; }
				.hero-inner { flex-direction: column; text-align: center; gap: 1.5rem; }
				.lede { margin-left: auto; margin-right: auto; }
				.hero-cta { justify-content: center; }
				.cards { grid-template-columns: 1fr; gap: 1.25rem; }
				.section-head { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
				.band { padding: 3rem 1rem; }
			}
		</style>
	</body>
</html>
