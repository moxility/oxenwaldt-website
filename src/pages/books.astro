---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BookBuyLinks from '../components/BookBuyLinks.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
import { BOOKS, fullTitle, plain } from '../data/books.mjs';
import { STATES, bySlug } from '../data/apps.mjs';

const description =
	'The books of Magnus Oxenwaldt: AI Don’t Fix Stupidity, on what an organisation has to ' +
	'become when AI arrives, and AI Don’t Make You Smarter, on who you have to become inside it.';

const iconFor = (app: { accent: string; glyph: string }) =>
	'data:image/svg+xml,' +
	encodeURIComponent(
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">` +
			`<rect width="100" height="100" rx="18" fill="#0D2454"/>` +
			`<path fill="none" stroke="${app.accent}" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" d="${app.glyph}"/>` +
			`</svg>`,
	);

// Only fields the books themselves or a live listing support. No offers block: a
// price in structured data goes stale silently.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Books | ${SITE_TITLE}`,
	description,
	url: `${SITE_URL}/books/`,
	hasPart: BOOKS.map((b) => ({
		'@type': 'Book',
		'@id': `${SITE_URL}/books/#${b.slug}`,
		name: b.title,
		alternativeHeadline: b.subtitle,
		author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: 'Magnus Oxenwaldt' },
		inLanguage: 'en',
		bookFormat: 'https://schema.org/Paperback',
		numberOfPages: b.numberOfPages,
		image: `${SITE_URL}${b.cover}`,
		url: `${SITE_URL}/books/#${b.slug}`,
		description: `${b.headline}. ${plain(b.blurb[0])}`,
		...(b.isbn ? { isbn: b.isbn } : {}),
		...(b.datePublished ? { datePublished: b.datePublished } : {}),
		...(b.publisher ? { publisher: { '@type': 'Organization', name: b.publisher } } : {}),
		// These identifiers describe the paperback edition only. Other formats'
		// store links must not be attached to that edition's ISBN.
		...(b.buy.paperback.some((x) => x.isbn === b.isbn)
			? { sameAs: b.buy.paperback.filter((x) => x.isbn === b.isbn).map((x) => x.href) }
			: {}),
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Books | ${SITE_TITLE}`} description={description} image="/images/books/books-og.jpg" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<Header />

		<section class="books-hero">
			<div class="books-hero-inner">
				<p class="kicker">Books</p>
				<h1>Two books on AI at work</h1>
				<p class="lede">
					The first asks what the company has to become. The second asks who you have
					to become inside it.
				</p>
				<nav class="book-jump" aria-label="The books">
					{BOOKS.map((b) => (
						<a href={`#${b.slug}`}>
							<img src={b.cover} alt="" width={b.coverSize[0]} height={b.coverSize[1]} />
							<span>
								<b>{b.title}</b>
								<span>{b.subtitle}</span>
								<span class="jump-buy">Explore the book &amp; buying options ↓</span>
							</span>
						</a>
					))}
				</nav>
			</div>
		</section>

		<main class="books-main">
			{BOOKS.map((b, i) => (
				<article class="book" id={b.slug}>
					<div class="book-cover">
						<img
							src={b.cover}
							alt={`Cover of ${fullTitle(b)} by Magnus Oxenwaldt`}
							width={b.coverSize[0]}
							height={b.coverSize[1]}
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					</div>

					<div class="book-text">
						<p class="book-kicker">
							<span class="status-pill">{b.status}</span>
							<span>{i === 0 ? 'The first book' : 'The second book'}</span>
						</p>
						<h2>{b.title}</h2>
						<p class="subtitle">{b.subtitle}</p>
						<BookBuyLinks book={b} />

						<p class="headline">{b.headline}</p>
						{b.blurb.map((p) => <p set:html={p} />)}
						<ul class="questions">
							{b.questions.map((q) => <li>{q}</li>)}
						</ul>
						{b.after.map((p) => <p set:html={p} />)}
						<p class="close">
							{b.close.map((line) => <span>{line}</span>)}
						</p>

						<div class="inside">
							<h3>Inside</h3>
							<p set:html={b.inside} />
						</div>

						<dl class="details">
							{b.details.map(([k, v]) => (
								<div>
									<dt>{k}</dt>
									<dd>{v}</dd>
								</div>
							))}
						</dl>

						{b.companions.length > 0 && (
							<div class="companions">
								<h3>{b.companions.length > 1 ? 'Companions' : 'Companion'}</h3>
								<div class="companion-list">
									{b.companions
										.map((slug) => bySlug(slug))
										.filter(Boolean)
										.map((app) => (
											<a class="companion" href={`/${app.slug}/index.html`}>
												<img src={iconFor(app)} alt="" width="44" height="44" loading="lazy" />
												<span>
													<b>{app.name}</b>
													<span class="companion-tag">{app.tagline}</span>
													<span class="companion-state">{STATES[app.state as keyof typeof STATES].label}</span>
												</span>
											</a>
										))}
								</div>
							</div>
						)}
					</div>
				</article>
			))}
		</main>

		<Footer />

		<style>
			.books-hero {
				background: var(--cream-soft);
				border-bottom: 1px solid var(--rule);
				padding: 4rem 1.5rem 3rem;
			}
			.books-hero-inner {
				max-width: 64rem;
				margin: 0 auto;
			}
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.85rem;
				font-weight: 600;
			}
			.books-hero h1 {
				font-size: clamp(2.4rem, 5vw, 3.4rem);
				margin: 0 0 1rem;
				line-height: 1.05;
			}
			.lede {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.4rem;
				line-height: 1.45;
				color: var(--ink-soft);
				max-width: 40rem;
				margin: 0 0 2.25rem;
			}
			.book-jump {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.book-jump a {
				display: flex;
				gap: 1rem;
				align-items: center;
				padding: 0.85rem 1rem;
				border: 1px solid var(--rule);
				border-radius: 12px;
				background: #fff;
				color: var(--text);
				text-decoration: none;
				transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
			}
			.book-jump a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow-lg);
				transform: translateY(-2px);
				color: var(--text);
			}
			.book-jump img {
				width: 3.5rem;
				height: auto;
				border-radius: 3px;
				box-shadow: var(--box-shadow);
				flex: none;
			}
			.book-jump b {
				display: block;
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.15rem;
				line-height: 1.2;
				margin-bottom: 0.15rem;
			}
			.book-jump span span {
				font-size: 0.88rem;
				color: var(--text-muted);
				line-height: 1.35;
			}
			.book-jump .jump-buy { display: block; margin-top: 0.5rem; color: var(--accent); }

			.books-main {
				width: 64rem;
				max-width: calc(100% - 3rem);
				padding: 1rem 0 2rem;
			}
			.book {
				display: grid;
				grid-template-columns: 17rem minmax(0, 1fr);
				gap: 3.5rem;
				padding: 3.5rem 0;
				border-bottom: 1px solid var(--rule);
				scroll-margin-top: 1rem;
			}
			.book:last-child { border-bottom: none; }
			.book-cover img {
				position: sticky;
				top: 2rem;
				display: block;
				width: 100%;
				border-radius: 4px;
				box-shadow: 0 18px 40px -18px rgb(15 31 58 / 0.45), 0 4px 10px -4px rgb(15 31 58 / 0.18);
			}
			.book-kicker {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin: 0 0 1rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.status-pill {
				display: inline-block;
				background: var(--accent);
				color: var(--cream);
				font-size: 0.72rem;
				font-weight: 600;
				padding: 0.2rem 0.7rem;
				border-radius: 9999px;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.book h2 {
				font-size: clamp(2rem, 4vw, 2.6rem);
				margin: 0 0 0.35rem;
			}
			.subtitle {
				font-family: 'Newsreader', Georgia, serif;
				font-style: italic;
				font-size: 1.25rem;
				color: var(--accent);
				margin: 0 0 2rem;
			}
			.headline {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.55rem;
				line-height: 1.3;
				color: var(--ink);
				margin: 0 0 1rem;
			}
			.book-text > p { color: var(--text); }
			.questions {
				list-style: none;
				padding: 0 0 0 1.25rem;
				margin: 0 0 1.25rem;
				border-left: 3px solid var(--accent);
			}
			.questions li {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.2rem;
				line-height: 1.45;
				color: var(--ink-soft);
				margin: 0 0 0.4rem;
			}
			.close {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.35rem;
				line-height: 1.4;
				color: var(--ink);
				margin: 1.75rem 0 2.25rem;
			}
			.close span { display: block; }
			.close span:last-child { font-weight: 600; }

			.inside {
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				border-radius: 8px;
				padding: 1.25rem 1.5rem;
				margin: 0 0 1.75rem;
			}
			.inside h3,
			.companions h3 {
				font-family: 'Inter', sans-serif;
				font-size: 0.75rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-muted);
				font-weight: 600;
				margin: 0 0 0.5rem;
			}
			.inside p {
				margin: 0;
				font-size: 1rem;
				line-height: 1.6;
			}

			.details {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
				gap: 0.75rem 1.5rem;
				margin: 0 0 1.75rem;
			}
			.details dt {
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-muted);
				font-weight: 600;
			}
			.details dd {
				margin: 0.1rem 0 0;
				font-size: 0.98rem;
				color: var(--ink);
			}

			.companion-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
				gap: 0.75rem;
			}
			.companion {
				display: flex;
				gap: 0.85rem;
				align-items: flex-start;
				padding: 0.9rem 1rem;
				border: 1px solid var(--rule);
				border-radius: 12px;
				background: #fff;
				color: var(--text);
				text-decoration: none;
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.companion:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow-lg);
				color: var(--text);
			}
			.companion img {
				width: 44px;
				height: 44px;
				border-radius: 10px;
				flex: none;
			}
			.companion b {
				display: block;
				font-size: 0.98rem;
				line-height: 1.25;
			}
			.companion-tag {
				display: block;
				font-size: 0.85rem;
				color: var(--text-muted);
				line-height: 1.4;
				margin: 0.15rem 0 0.3rem;
			}
			.companion-state {
				display: block;
				font-size: 0.75rem;
				color: var(--accent);
				font-weight: 600;
			}

			@media (max-width: 720px) {
				.books-hero { padding: 3rem 1rem 2.25rem; }
				.lede { font-size: 1.2rem; }
				.book-jump { grid-template-columns: 1fr; }
				.books-main { max-width: calc(100% - 2rem); }
				.book {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding: 2.5rem 0;
				}
				.book-cover { max-width: 14rem; margin: 0 auto; }
				.book-cover img { position: static; }
			}
		</style>
	</body>
</html>
