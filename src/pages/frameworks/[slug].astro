---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';
import { BOOKS } from '../../data/books.mjs';
import { FRAMEWORKS } from '../../data/frameworks.mjs';

export function getStaticPaths() {
	return FRAMEWORKS.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}

const { f } = Astro.props;
const book = BOOKS[f.book - 1];
const sources = (f.books ?? [f.book]).map((n: number) => BOOKS[n - 1]);
const siblings = FRAMEWORKS.filter((x) => x.book === f.book && x.slug !== f.slug).slice(0, 4);

// Structure is authored as lists; numbers such as 20/70/10 are content, not markup.
const levels = f.levels;
const citation = `Oxenwaldt, M. (2026). ${sources.map((b: typeof book) => b.title).join(' and ')}.`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	name: f.name,
	description: f.summary,
	url: `${SITE_URL}/frameworks/${f.slug}/`,
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Frameworks by Magnus Oxenwaldt', url: `${SITE_URL}/frameworks/` },
	subjectOf: sources.map((b: typeof book) => ({ '@type': 'Book', name: b.title, author: { '@type': 'Person', name: 'Magnus Oxenwaldt' }, url: `${SITE_URL}/books/#${b.slug}` })),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${f.name} | Frameworks | ${SITE_TITLE}`} description={f.summary.slice(0, 155)} pageType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<Header />
		<main class="fw">
			<p class="crumb"><a href="/frameworks">Frameworks</a> · <em>{sources.map((b: typeof book) => b.title).join(' and ')}</em></p>
			<h1>{f.name}</h1>
			{f.aka && <p class="aka">Also called {f.aka}</p>}
			{f.definition && <blockquote>{f.definition.replace(/^"|"$/g, '')}</blockquote>}

			{levels.length > 0 && (
				<section class="levels" aria-label={f.levelsLabel || 'Structure'}>
					{levels.map((group: { label: string; steps: string[]; numbered?: boolean }) => (
						<div class="level-group">
							{(group.label || f.levelsLabel) && <h2>{group.label || f.levelsLabel}</h2>}
							<ol class:list={{ unnumbered: group.numbered === false }}>{group.steps.map((s: string) => <li>{s}</li>)}</ol>
						</div>
					))}
				</section>
			)}

			<p class="summary">{f.summary}</p>

			{f.monday && (
				<div class="monday">
					<h2>Use it on Monday</h2>
					<p>{f.monday}</p>
				</div>
			)}

			<aside class="source">
				{sources.map((b: typeof book) => (
					<a href={`/books#${b.slug}`} class="src-book">
						<img src={b.cover} alt="" width={b.coverSize[0]} height={b.coverSize[1]} loading="lazy" />
						<span><b>{b.title}</b><span>{b.subtitle}</span><span class="buy">Get the book →</span></span>
					</a>
				))}
				<p class="where">{f.chapter}.</p>
				<p class="citation"><b>Cite as:</b> {citation} {f.original && 'Original framework; may be referenced and adapted with attribution.'}</p>
			</aside>

			{siblings.length > 0 && (
				<nav class="more" aria-label="More frameworks">
					<h2>More from this book</h2>
					<ul>{siblings.map((x) => <li><a href={`/frameworks/${x.slug}/`}>{x.name}</a></li>)}</ul>
					<a href="/frameworks" class="all">All frameworks →</a>
				</nav>
			)}
		</main>
		<Footer />
		<style>
			.fw { max-width: 44rem; margin: 0 auto; padding: 3rem 1.5rem 2rem; }
			.crumb { font-size: 0.85rem; color: var(--text-muted); margin: 0 0 1rem; }
			.crumb a { color: var(--accent); }
			h1 { font-size: clamp(2.2rem, 5vw, 3.1rem); line-height: 1.08; margin: 0 0 0.5rem; }
			.aka { color: var(--text-muted); margin: 0 0 1rem; }
			blockquote { margin: 1.5rem 0 2rem; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 3px solid var(--accent); font-family: 'Newsreader', 'Newsreader Fallback', Georgia, serif; font-size: 1.35rem; line-height: 1.45; color: var(--ink); }
			.levels { margin: 0 0 2rem; display: grid; gap: 1rem; }
			.level-group h2, .monday h2, .more h2 { font-family: 'Inter', 'Inter Fallback', sans-serif; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.6rem; }
			.level-group ol { list-style: none; counter-reset: step; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
			.level-group li { counter-increment: step; padding: 0.55rem 0.9rem; border-radius: 6px; background: var(--ink); color: var(--cream); font-weight: 600; font-size: 0.95rem; }
			.level-group ol:not(.unnumbered) li::before { content: counter(step); color: var(--accent-light); margin-right: 0.5rem; font-weight: 700; }
			.summary { font-size: 1.08rem; line-height: 1.75; }
			.monday { margin: 2rem 0; padding: 1.25rem 1.5rem; border-radius: 8px; background: var(--cream-soft); border: 1px solid var(--rule); }
			.monday p { margin: 0; }
			.source { margin: 2.5rem 0; padding: 1.5rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
			.src-book { display: flex; gap: 1rem; align-items: center; color: inherit; text-decoration: none; margin-bottom: 1rem; }
			.src-book img { width: 4rem; height: auto; border-radius: 2px; box-shadow: var(--box-shadow-lg); }
			.src-book span { display: flex; flex-direction: column; }
			.src-book b { color: var(--ink); font-size: 1.1rem; }
			.src-book span span { color: var(--text-muted); font-size: 0.9rem; }
			.src-book .buy { color: var(--accent) !important; font-weight: 600; margin-top: 0.2rem; }
			.where, .citation { font-size: 0.88rem; color: var(--text-muted); margin: 0.3rem 0 0; }
			.more ul { padding-left: 1.2rem; margin: 0 0 0.75rem; }
			.more a { color: var(--accent); }
		</style>
	</body>
</html>
