---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';
import { CATEGORY_ORDER, PUBLIC_APPS, STATES, appStoreUrl } from '../../data/apps.mjs';

// Group by category, in a deliberate order, so the certification range reads as a
// range rather than as five separate things that happen to share a developer.
const grouped = CATEGORY_ORDER.map((category) => ({
	category,
	apps: PUBLIC_APPS.filter((a) => a.category === category),
})).filter((g) => g.apps.length > 0);

const live = PUBLIC_APPS.filter((a) => a.state === 'live').length;
const submitted = PUBLIC_APPS.filter((a) => a.state === 'review' || a.state === 'prep').length;

const iconFor = (app: { accent: string; glyph: string }) =>
	'data:image/svg+xml,' +
	encodeURIComponent(
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">` +
			`<rect width="100" height="100" rx="18" fill="#0D2454"/>` +
			`<path fill="none" stroke="${app.accent}" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" d="${app.glyph}"/>` +
			`</svg>`,
	);

const description =
	'The iPhone apps Magnus Oxenwaldt builds — certification practice with an on-device AI tutor, ' +
	'executive writing tools, and the companions to the AI Don’t Fix Stupidity books.';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Apps | ${SITE_TITLE}`,
	description,
	url: `${SITE_URL}/apps/`,
	hasPart: PUBLIC_APPS.map((a) => ({
		'@type': 'SoftwareApplication',
		name: a.name,
		applicationCategory: 'MobileApplication',
		operatingSystem: 'iOS',
		url: `${SITE_URL}/${a.slug}/index.html`,
		...(appStoreUrl(a) ? { sameAs: appStoreUrl(a) } : {}),
		author: { '@type': 'Person', name: 'Magnus Oxenwaldt' },
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Apps | ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<Header />

		<section class="apps-hero">
			<div class="apps-hero-inner">
				<p class="kicker">Apps</p>
				<h1>Things I build for the iPhone</h1>
				<p class="lede">
					Certification practice with a tutor that runs on the phone rather than in
					someone else&rsquo;s data centre. Writing tools for executives that never see a
					server. And the companions to the books. One principle runs through all of
					them: if the work can happen on the device, it happens on the device.
				</p>
				<p class="counts">
					<span><strong>{PUBLIC_APPS.length}</strong> apps</span>
					<span><strong>{live}</strong> on the App Store</span>
					<span><strong>{submitted}</strong> submitted or in preparation</span>
				</p>
			</div>
		</section>

		<main class="apps-main">
			{
				grouped.map((group) => (
					<section class="group">
						<h2>{group.category}</h2>
						<div class="grid">
							{group.apps.map((app) => {
								const state = STATES[app.state as keyof typeof STATES];
								const store = appStoreUrl(app);
								return (
									<a class="app-card" href={`/${app.slug}/index.html`}>
										<img class="icon" src={iconFor(app)} alt="" width="52" height="52" loading="lazy" />
										<div class="body">
											<h3>{app.name}</h3>
											<p class="tag">{app.tagline}</p>
											<p class={`state ${state.tone}`}>
												<span class="dot" />
												{state.label}
											</p>
										</div>
										{store && state.cta === 'download' && <span class="badge">App Store</span>}
									</a>
								);
							})}
						</div>
					</section>
				))
			}

			<section class="why">
				<h2>Why they all work offline</h2>
				<p>
					Every app here that reasons does it with Apple&rsquo;s on-device Foundation
					Models — so a study tutor, a board memo, or a conversation with a simulated
					candidate never leaves the phone. There is no server to send it to, which
					means there is no server to breach, no data to sell, and nothing to train on.
					That constraint costs something: those features need an iPhone 15 Pro or
					newer on iOS 26 with Apple Intelligence enabled, and on anything older they
					report as unavailable rather than quietly falling back to the cloud.
				</p>
				<p class="ask">
					Missing a certification you need, or want one of these on the iPad?
					<a href="mailto:magnus@oxenwaldt.com?subject=Apps%20—%20request">Tell me</a> and
					it moves up the list.
				</p>
			</section>
		</main>

		<Footer />

		<style>
			.apps-hero {
				background: var(--cream-soft);
				border-bottom: 1px solid var(--rule);
				padding: 4rem 1.5rem 3.5rem;
			}
			.apps-hero-inner {
				max-width: 46rem;
				margin: 0 auto;
			}
			.kicker {
				text-transform: uppercase;
				letter-spacing: 0.12em;
				font-size: 0.78rem;
				font-weight: 650;
				color: var(--accent);
				margin: 0 0 0.6rem;
			}
			.apps-hero h1 {
				font-size: 2.9rem;
				margin: 0 0 1rem;
			}
			.lede {
				font-size: 1.15rem;
				color: var(--ink-soft);
				margin: 0;
			}
			.counts {
				display: flex;
				flex-wrap: wrap;
				gap: 1.75rem;
				margin: 1.75rem 0 0;
				font-size: 0.95rem;
				color: var(--text-muted);
			}
			.counts strong {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.3rem;
				margin-right: 0.35rem;
			}

			.apps-main {
				width: 64rem;
				max-width: calc(100% - 3rem);
				margin: 0 auto;
				padding: 3.5rem 0 4rem;
			}
			.group {
				margin-bottom: 3rem;
			}
			.group h2 {
				font-size: 1.6rem;
				margin: 0 0 1.25rem;
				padding-bottom: 0.6rem;
				border-bottom: 1px solid var(--rule);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
				gap: 1rem;
			}
			.app-card {
				display: flex;
				gap: 1rem;
				align-items: flex-start;
				padding: 1.15rem 1.25rem;
				border: 1px solid var(--rule);
				border-radius: 12px;
				background: #fff;
				text-decoration: none;
				color: var(--text);
				position: relative;
				transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
			}
			.app-card:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow-lg);
				transform: translateY(-2px);
				color: var(--text);
			}
			.icon {
				width: 52px;
				height: 52px;
				border-radius: 12px;
				flex: none;
				margin: 0;
			}
			.body {
				min-width: 0;
			}
			.app-card h3 {
				font-size: 1.08rem;
				margin: 0 0 0.2rem;
				line-height: 1.25;
			}
			.tag {
				margin: 0 0 0.55rem;
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.45;
			}
			.state {
				margin: 0;
				font-size: 0.8rem;
				color: var(--text-muted);
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}
			.dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--text-muted);
				flex: none;
			}
			.state.good .dot { background: #2f8a4c; }
			.state.good { color: #2f8a4c; font-weight: 600; }
			.state.wait .dot { background: var(--accent); }
			.badge {
				position: absolute;
				top: 0.9rem;
				right: 0.9rem;
				font-size: 0.68rem;
				font-weight: 650;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: #2f8a4c;
				border: 1px solid rgba(47, 138, 76, 0.35);
				background: rgba(47, 138, 76, 0.08);
				padding: 3px 8px;
				border-radius: 999px;
			}

			.why {
				border-top: 1px solid var(--rule);
				padding-top: 2.5rem;
				max-width: 46rem;
			}
			.why h2 {
				font-size: 1.6rem;
				margin: 0 0 1rem;
			}
			.why p {
				color: var(--text);
			}
			.ask {
				color: var(--text-muted);
			}

			@media (max-width: 720px) {
				.apps-hero { padding: 3rem 1.25rem 2.5rem; }
				.apps-hero h1 { font-size: 2.1rem; }
				.grid { grid-template-columns: 1fr; }
				.counts { gap: 1.25rem; }
			}
		</style>
	</body>
</html>
