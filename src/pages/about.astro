---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Magnus Oxenwaldt — VP Group AI at Columbus Global. Two decades helping enterprises turn AI into measurable business outcomes." pageType="profile" />
	</head>
	<body>
		<Header />

		<section class="about-hero">
			<div class="about-hero-inner">
				<p class="kicker">About</p>
				<h1>Magnus Oxenwaldt</h1>
				<p class="role">VP Group AI · Columbus Global · Host of Future Bytes</p>
			</div>
		</section>

		<main class="about-main">
			<section class="bio">
				<div class="bio-inner">
					<img src="/images/magnus_portrait_casual.png" alt="Magnus Oxenwaldt" class="portrait" />
					<div class="bio-text">
						<p class="bio-lede">
							I help enterprises navigate AI transformation — from board-level strategy through to systems running in production.
						</p>
						<p>
							I've spent the last twenty years inside enterprise architecture: ERP, customer engagement, integration, and now AI. Today I lead Columbus Global's AI practice as VP Group AI, driving "The Shift" — our strategy for delivering measurable AI outcomes to clients across Europe and North America.
						</p>
						<p>
							I host <em>Future Bytes</em>, a weekly podcast unpacking the AI news that actually matters for business leaders. I speak at executive forums, board off-sites, and industry events. I write here about the things I keep hitting in practice — and the patterns that separate AI projects that ship from the ones that don't.
						</p>
					</div>
				</div>
			</section>

			<section class="focus">
				<h2>Areas of focus</h2>
				<div class="focus-grid">
					<div class="focus-item">
						<h3>AI strategy &amp; implementation</h3>
						<p>Frontier-model implementations, agentic systems, prompt engineering, and the evaluation infrastructure that makes them durable. Practical, not theoretical.</p>
					</div>
					<div class="focus-item">
						<h3>Enterprise architecture</h3>
						<p>Microsoft Dynamics 365, Azure, and Power Platform. Where AI lives, breaks, and gets governed.</p>
					</div>
					<div class="focus-item">
						<h3>Digital transformation</h3>
						<p>Enterprise-wide change programs. The organizational and cultural mechanics around tech adoption — change management as the gating constraint.</p>
					</div>
					<div class="focus-item">
						<h3>Executive advisory</h3>
						<p>Board-level briefings, AI strategy reviews, and trusted second opinions for CIOs and CEOs navigating the next decade.</p>
					</div>
				</div>
			</section>

			<section class="links">
				<div class="link-card">
					<h3>Future Bytes Podcast</h3>
					<p>Weekly conversations and AI news for business leaders. Concise — most episodes under ten minutes.</p>
					<a href="/podcast" class="link-arrow">Listen →</a>
				</div>
				<div class="link-card">
					<h3>The book</h3>
					<p>A practical guide to AI adoption and digital transformation, drawn from twenty years inside the work. Coming soon.</p>
					<span class="status-pill">In progress</span>
				</div>
			</section>

			<section class="connect">
				<h2>Let's connect</h2>
				<p>Available for executive advisory, keynote speaking, and strategic consulting worldwide.</p>
				<div class="connect-cta">
					<a href="https://www.linkedin.com/in/magnusoxenwaldt/" target="_blank" rel="noopener noreferrer" class="btn-primary">Message on LinkedIn</a>
					<a href="mailto:magnus@oxenwaldt.com" class="btn-ghost">Email Magnus</a>
				</div>
			</section>
		</main>

		<Footer />

		<style>
			.about-hero {
				background: var(--cream);
				border-bottom: 1px solid var(--rule);
				padding: 4.5rem 1.5rem 3.5rem;
			}
			.about-hero-inner {
				max-width: 56rem;
				margin: 0 auto;
				text-align: center;
			}
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.85rem;
				font-weight: 600;
			}
			.about-hero h1 {
				font-size: clamp(2.6rem, 5vw, 3.8rem);
				margin: 0 0 0.75rem;
				color: var(--ink);
				line-height: 1.05;
			}
			.role {
				font-size: 1.1rem;
				color: var(--text-muted);
				margin: 0;
			}

			.about-main { max-width: 56rem; padding: 0 1.5rem; }

			.bio { padding: 4rem 0 3rem; border-bottom: 1px solid var(--rule); }
			.bio-inner {
				display: flex;
				gap: 3rem;
				align-items: flex-start;
			}
			.portrait {
				flex-shrink: 0;
				width: 12rem;
				height: 12rem;
				border-radius: 9999px;
				object-fit: cover;
				border: 1px solid var(--rule);
				box-shadow: var(--box-shadow-lg);
			}
			.bio-text { flex: 1; }
			.bio-lede {
				font-family: 'Newsreader', Georgia, serif;
				font-size: 1.5rem;
				color: var(--ink);
				line-height: 1.4;
				margin: 0 0 1.5rem;
				letter-spacing: -0.01em;
			}
			.bio-text p {
				color: var(--text);
				font-size: 1.05rem;
				line-height: 1.7;
			}

			.focus { padding: 3rem 0; border-bottom: 1px solid var(--rule); }
			.focus h2 {
				font-size: 1.6rem;
				margin: 0 0 2rem;
				color: var(--ink);
			}
			.focus-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
			}
			.focus-item h3 {
				font-size: 1.2rem;
				margin: 0 0 0.6rem;
				color: var(--ink);
			}
			.focus-item p {
				color: var(--text-muted);
				font-size: 0.98rem;
				line-height: 1.6;
				margin: 0;
			}

			.links {
				padding: 3rem 0;
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.5rem;
				border-bottom: 1px solid var(--rule);
			}
			.link-card {
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				border-radius: 8px;
				padding: 1.75rem;
			}
			.link-card h3 {
				font-size: 1.25rem;
				margin: 0 0 0.6rem;
				color: var(--ink);
			}
			.link-card p {
				color: var(--text-muted);
				font-size: 0.98rem;
				margin: 0 0 1rem;
				line-height: 1.55;
			}
			.link-arrow {
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
			}
			.link-arrow:hover { color: var(--accent-dark); }
			.status-pill {
				display: inline-block;
				background: var(--accent);
				color: var(--cream);
				font-size: 0.75rem;
				font-weight: 500;
				padding: 0.25rem 0.75rem;
				border-radius: 9999px;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.connect { padding: 3rem 0 4rem; text-align: center; }
			.connect h2 { font-size: 1.7rem; color: var(--ink); margin: 0 0 0.75rem; }
			.connect p { color: var(--text-muted); margin: 0 0 2rem; }
			.connect-cta {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.btn-primary {
				display: inline-flex;
				background: var(--ink);
				color: var(--cream);
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				font-weight: 500;
				text-decoration: none;
				transition: background 0.2s;
			}
			.btn-primary:hover { background: var(--accent); }
			.btn-ghost {
				display: inline-flex;
				background: transparent;
				color: var(--ink);
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				border: 1px solid var(--rule);
				font-weight: 500;
				text-decoration: none;
				transition: border-color 0.2s;
			}
			.btn-ghost:hover { border-color: var(--ink); }

			@media (max-width: 720px) {
				.bio-inner { flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; }
				.focus-grid, .links { grid-template-columns: 1fr; }
				.about-hero { padding: 3rem 1rem 2.5rem; }
				.bio { padding: 2.5rem 0; }
			}
		</style>
	</body>
</html>
