---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Learn more about Magnus Oxenwaldt - AI & Digital Transformation Leader" />
		<style>
			.card-hover {
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}
			.card-hover:hover {
				transform: translateY(-4px);
			}
		</style>
	</head>
	<body class="bg-slate-50">
		<Header />
		<main class="p-0">
			<!-- Hero Section -->
			<section class="bg-slate-900 text-white py-20 px-4 relative overflow-hidden">
				<div class="absolute inset-0 opacity-30">
					<img src="/images/about_background_20251210_170542.png" alt="" class="w-full h-full object-cover" />
				</div>
				<div class="max-w-4xl mx-auto relative z-10">
					<h1 class="text-5xl md:text-6xl font-black mb-4 tracking-tight">
						Magnus Oxenwaldt
					</h1>
					<p class="text-xl text-slate-400 font-semibold">
						AI Thought Leader & Strategic Advisor
					</p>
				</div>
			</section>

			<!-- Main Content -->
			<section class="py-16 px-4">
				<div class="max-w-4xl mx-auto">
					<!-- Bio with Portrait -->
					<div class="mb-12 bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
						<div class="flex flex-col md:flex-row gap-8 items-start">
							<!-- Portrait -->
							<div class="flex-shrink-0 mx-auto md:mx-0">
								<img
									src="/images/magnus_portrait_casual.png"
									alt="Magnus Oxenwaldt"
									class="w-48 h-48 md:w-56 md:h-56 rounded-2xl object-cover shadow-lg"
								/>
							</div>
							<!-- Bio Text -->
							<div class="flex-1">
								<p class="text-xl text-slate-700 leading-relaxed mb-4 font-medium">
									I help enterprises navigate AI transformation—from strategy through implementation.
								</p>
								<p class="text-slate-600 leading-relaxed">
									With 20+ years in enterprise architecture, I focus on making AI and emerging technologies
									deliver real business value, not just impressive demos. Through consulting, speaking, and my
									Future Bytes podcast, I share practical insights on navigating the AI era. My background spans
									technology, economics, and marketing—enabling me to bridge technical and business conversations.
								</p>
							</div>
						</div>
					</div>

					<!-- Expertise Grid -->
					<div class="mb-12">
						<h2 class="text-2xl font-black text-slate-900 mb-6">Areas of Focus</h2>
						<div class="grid md:grid-cols-2 gap-4">
							<div class="card-hover p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-lg">
								<div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
									</svg>
								</div>
								<h3 class="text-lg font-bold text-slate-900 mb-2">AI Implementation</h3>
								<p class="text-sm text-slate-600 leading-relaxed">
									Practical AI strategies using OpenAI, Anthropic, and other frontier models.
									Measuring real productivity gains, not vendor promises.
								</p>
							</div>
							<div class="card-hover p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-lg">
								<div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
									</svg>
								</div>
								<h3 class="text-lg font-bold text-slate-900 mb-2">Enterprise Architecture</h3>
								<p class="text-sm text-slate-600 leading-relaxed">
									ERP, CRM, and integration architecture. Making complex systems work
									together reliably.
								</p>
							</div>
							<div class="card-hover p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-lg">
								<div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
									</svg>
								</div>
								<h3 class="text-lg font-bold text-slate-900 mb-2">Digital Transformation</h3>
								<p class="text-sm text-slate-600 leading-relaxed">
									Enterprise-wide transformation initiatives, change management, and
									organizational adaptation.
								</p>
							</div>
							<div class="card-hover p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-lg">
								<div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mb-4">
									<svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
									</svg>
								</div>
								<h3 class="text-lg font-bold text-slate-900 mb-2">Business Strategy</h3>
								<p class="text-sm text-slate-600 leading-relaxed">
									Combining technology, economics, and market insights to drive
									strategic outcomes.
								</p>
							</div>
						</div>
					</div>

					<!-- Quick Links -->
					<div class="grid md:grid-cols-2 gap-6 mb-12">
						<!-- Podcast -->
						<div class="card-hover bg-slate-900 rounded-2xl p-6 text-white shadow-lg">
							<div class="w-10 h-10 bg-teal-600 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold mb-2">Future Bytes Podcast</h3>
							<p class="text-sm text-slate-400 mb-4 leading-relaxed">
								Weekly conversations on AI strategy and real-world implementation.
							</p>
							<a href="/podcast" class="inline-flex items-center gap-2 text-teal-400 font-bold text-sm hover:text-teal-300 transition-colors group">
								Listen now
								<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
								</svg>
							</a>
						</div>
						<!-- Book -->
						<div class="card-hover bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-lg">
							<div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mb-4">
								<svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-slate-900 mb-2">Upcoming Book</h3>
							<p class="text-sm text-slate-600 mb-4 leading-relaxed">
								Practical guidance for AI adoption and digital transformation. Coming soon.
							</p>
							<span class="inline-flex items-center gap-2 text-teal-600 font-bold text-sm">
								<span class="w-2 h-2 bg-teal-500 rounded-full animate-pulse"></span>
								Stay tuned
							</span>
						</div>
					</div>

					<!-- Connect CTA -->
					<div class="bg-slate-900 rounded-2xl p-10 text-center text-white">
						<h2 class="text-3xl font-black mb-3">Let's Connect</h2>
						<p class="text-slate-400 mb-6">
							Available for consulting, speaking, and strategic advisory worldwide.
						</p>
						<a href="https://www.linkedin.com/in/magnusoxenwaldt/"
						   target="_blank"
						   rel="noopener noreferrer"
						   class="inline-flex items-center gap-3 bg-teal-600 text-white px-8 py-4 rounded-xl font-bold hover:bg-teal-700 transition-colors">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
							<span>Connect on LinkedIn</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
