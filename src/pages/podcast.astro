---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const episodes = (await getCollection('episodes')).sort(
	(a, b) => b.data.episodeNumber - a.data.episodeNumber,
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Future Bytes Podcast | ${SITE_TITLE}`}
			description="Future Bytes — bits of business transformation. A weekly podcast on AI's impact on business, hosted by Magnus Oxenwaldt."
			pageType="podcast"
		/>
	</head>
	<body>
		<Header />

		<section class="podcast-hero">
			<div class="podcast-hero-inner">
				<div class="podcast-cover">
					<img src="/images/future_bytes_cover.jpg" alt="Future Bytes Podcast" />
				</div>
				<div class="podcast-text">
					<p class="kicker">The Podcast</p>
					<h1>Future Bytes</h1>
					<p class="tagline">Bits of business transformation</p>
					<p class="lede">
						Weekly conversations and AI news for business leaders. Most episodes
						are under ten minutes — what actually matters, no fluff.
					</p>
					<div class="platforms">
						<a href="https://open.spotify.com/show/2dUyQaG5wFvCPBkB2ErHKe" target="_blank" rel="noopener noreferrer" class="btn-primary">Spotify</a>
						<a href="https://podcasts.apple.com/no/podcast/future-bytes/id1784685801" target="_blank" rel="noopener noreferrer" class="btn-ghost">Apple Podcasts</a>
						<span class="ep-count">{episodes.length} episodes</span>
					</div>
				</div>
			</div>
		</section>

		<main class="podcast-main">
			<section class="episodes">
				<h2>All episodes</h2>
				<div class="episode-list">
					{episodes.map((episode) => (
						<article class="episode">
							<a href={episode.data.spotifyUrl || "https://open.spotify.com/show/2dUyQaG5wFvCPBkB2ErHKe"} target="_blank" rel="noopener noreferrer" class="episode-link">
								<div class="episode-num">#{episode.data.episodeNumber}</div>
								<div class="episode-body">
									<div class="episode-meta">
										<time><FormattedDate date={episode.data.pubDate} /></time>
										<span class="dot">·</span>
										<span>{episode.data.duration}</span>
										{episode.data.guest && (<><span class="dot">·</span><span class="guest">Guest: {episode.data.guest}</span></>)}
									</div>
									<h3>{episode.data.title}</h3>
									<p>{episode.data.description}</p>
									{episode.data.tags && episode.data.tags.length > 0 && (
										<div class="tags">
											{episode.data.tags.slice(0, 4).map((tag: string) => (<span class="tag">{tag}</span>))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="about-pod">
				<h2>About the show</h2>
				<p><strong>Future Bytes: Bits of business transformation</strong> is where AI strategy meets real-world implementation. Each episode unpacks how AI is changing industries through conversations with leaders who are actually doing the work.</p>
				<p>Hosted by <strong>Magnus Oxenwaldt</strong>, VP Group AI at Columbus Global. Released weekly. Most episodes 5–10 minutes, with deeper guest interviews running longer.</p>
			</section>
		</main>

		<Footer />

		<style>
			.podcast-hero {
				background: var(--cream);
				border-bottom: 1px solid var(--rule);
				padding: 4rem 1.5rem;
			}
			.podcast-hero-inner {
				max-width: 64rem;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				align-items: center;
			}
			.podcast-cover img {
				width: 12rem;
				height: 12rem;
				border-radius: 8px;
				box-shadow: var(--box-shadow-lg);
				border: 1px solid var(--rule);
			}
			.kicker {
				font-family: 'Inter', sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.5rem;
				font-weight: 600;
			}
			.podcast-text h1 {
				font-size: clamp(2.4rem, 5vw, 3.4rem);
				margin: 0 0 0.4rem;
				color: var(--ink);
				line-height: 1.05;
			}
			.tagline {
				font-family: 'Newsreader', Georgia, serif;
				color: var(--accent);
				font-style: italic;
				margin: 0 0 1rem;
				font-size: 1.2rem;
			}
			.lede {
				color: var(--text);
				margin: 0 0 1.5rem;
				font-size: 1.08rem;
				line-height: 1.6;
				max-width: 36rem;
			}
			.platforms { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
			.btn-primary {
				background: var(--ink);
				color: var(--cream);
				padding: 0.6rem 1.2rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: 500;
				font-size: 0.92rem;
				transition: background 0.2s;
			}
			.btn-primary:hover { background: var(--accent); color: var(--cream); }
			.btn-ghost {
				background: transparent;
				color: var(--ink);
				padding: 0.6rem 1.2rem;
				border-radius: 6px;
				border: 1px solid var(--rule);
				text-decoration: none;
				font-weight: 500;
				font-size: 0.92rem;
				transition: border-color 0.2s;
			}
			.btn-ghost:hover { border-color: var(--ink); }
			.ep-count { color: var(--text-muted); font-size: 0.92rem; margin-left: 0.4rem; }

			.podcast-main { max-width: 56rem; padding: 0 1.5rem; }
			.episodes { padding: 4rem 0 3rem; border-bottom: 1px solid var(--rule); }
			.episodes h2 { font-size: 1.6rem; margin: 0 0 2rem; color: var(--ink); }
			.episode-list { display: flex; flex-direction: column; }
			.episode { border-bottom: 1px solid var(--rule); }
			.episode:last-child { border-bottom: none; }
			.episode-link {
				display: flex;
				gap: 1.5rem;
				padding: 1.5rem 0;
				text-decoration: none;
				color: inherit;
			}
			.episode-num {
				flex-shrink: 0;
				width: 3.5rem;
				height: 3.5rem;
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				border-radius: 6px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: 'Newsreader', Georgia, serif;
				color: var(--accent);
				font-weight: 600;
				font-size: 1rem;
			}
			.episode-body { flex: 1; min-width: 0; }
			.episode-meta {
				display: flex;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.4rem;
				flex-wrap: wrap;
				align-items: center;
			}
			.dot { color: var(--rule); }
			.guest { color: var(--accent); font-weight: 500; }
			.episode h3 {
				font-size: 1.25rem;
				margin: 0 0 0.4rem;
				color: var(--ink);
				transition: color 0.2s;
			}
			.episode-link:hover h3 { color: var(--accent); }
			.episode p {
				color: var(--text-muted);
				margin: 0 0 0.75rem;
				font-size: 0.98rem;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
			.tag {
				background: var(--cream-soft);
				border: 1px solid var(--rule);
				color: var(--text-muted);
				font-size: 0.75rem;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
			}

			.about-pod { padding: 3rem 0 4rem; }
			.about-pod h2 { font-size: 1.6rem; margin: 0 0 1rem; color: var(--ink); }
			.about-pod p { color: var(--text); margin: 0 0 1rem; line-height: 1.7; }

			@media (max-width: 720px) {
				.podcast-hero-inner { flex-direction: column; text-align: center; gap: 1.5rem; }
				.podcast-cover img { width: 9rem; height: 9rem; }
				.platforms { justify-content: center; }
				.podcast-hero { padding: 2.5rem 1rem; }
				.episode-link { gap: 1rem; padding: 1.25rem 0; }
				.episode-num { width: 2.75rem; height: 2.75rem; font-size: 0.85rem; }
			}
		</style>
	</body>
</html>
